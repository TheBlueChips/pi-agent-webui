{
  "expo": {
    "name": "Pi Agent",
    "slug": "pi-agent-mobile",
    "version": "0.2.0",
    "orientation": "default",
    "scheme": "piagent",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101318",
    "splash": {
      "backgroundColor": "#101318",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.thebluechips.piagent",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        },
        "LSApplicationQueriesSchemes": ["instagram", "tiktok", "vnd.youtube", "youtube"]
      }
    },
    "android": {
      "package": "com.thebluechips.piagent",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
